{
    "name": "libultrahdr",
    "version": "2.0.2",
    "description": "Library for encoding and decoding Ultra HDR (JPEG_R) images",
    "homepage": "https://github.com/google/libultrahdr",
    "license": "Apache-2.0",
    "dependencies": [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        },
        {
            "name": "pkgconf",
            "host": true
        },
        "libjpeg-turbo"
    ],
    "features": {
        "gles": {
            "description": "Enable GPU acceleration ",
            "dependencies": ["egl"]
        }
    }
}
