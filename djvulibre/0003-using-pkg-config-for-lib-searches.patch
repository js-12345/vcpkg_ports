diff --git a/configure.ac b/configure.ac
index eb9c322..42a397f 100755
--- a/configure.ac
+++ b/configure.ac
@@ -142,6 +142,8 @@ AC_CXX_MEMBER_TEMPLATES
 AC_CXX_INTEL_ATOMIC_BUILTINS
 AC_CXX_GCCTLS
 
+PKG_PROG_PKG_CONFIG([0.20])
+
 # ----------------------------------------
 # Setting CPPFLAGS
 # ----------------------------------------
@@ -223,10 +225,31 @@ fi
 have_pthread=no
 AM_COND_IF([HAVE_OS_WIN32],,[AC_PATH_PTHREAD([have_pthread=yes])])
 
-# Search JPEG library
-AC_PATH_JPEG([have_jpeg="yes"], [have_jpeg="no"])
-AC_MSG_CHECKING([for libjpeg])
-AC_MSG_RESULT([${have_jpeg}])
+#
+# Check for JPEG library.
+#
+AC_ARG_WITH([jpeg],
+    [AS_HELP_STRING([--without-jpeg], [disable JPEG support])],
+    [with_jpeg=$withval],
+    [with_jpeg='yes'])
+
+have_jpeg='no'
+JPEG_CFLAGS=""
+JPEG_LIBS=""
+JPEG_PKG=""
+if test "x$with_jpeg" = "xyes"; then
+  AC_MSG_RESULT([-------------------------------------------------------------])
+  PKG_CHECK_MODULES([JPEG],[libjpeg >= 2.0.0],[have_jpeg=yes],[have_jpeg=no])
+  AC_MSG_RESULT([])
+fi
+
+if test "$have_jpeg" = 'yes'; then
+  AC_DEFINE(HAVE_JPEG,1,[Define if you have the IJG JPEG library.])
+  CFLAGS="$JPEG_CFLAGS $CFLAGS"
+  CXXFLAGS="$JPEG_CFLAGS $CXXFLAGS"
+elif test "x$with_jpeg" != "xno"; then
+  AC_MSG_ERROR([Requested libjpeg library, but libjpeg could not be found])
+fi
 
 # Search TIFF library
 AC_PATH_TIFF([have_tiff="yes"], [have_tiff="no"])
