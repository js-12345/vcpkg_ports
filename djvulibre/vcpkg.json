{
    "name": "djvulibre",
    "version": "3.5.27.1",
    "description": "Open-source library and tools for viewing and processing DjVu documents",
    "homepage": "https://djvu.sourceforge.net/",
    "dependencies": [
         {
            "name": "vcpkg-make",
            "host": true
        }
    ],
    "default-features": ["jpeg"],
    "features": {
        "jpeg": {
            "description": "build with jpeg feature",
            "dependencies": ["libjpeg-turbo"]
        }
    }
}
